# ==============================================================================
# GABRIEL — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# 
# ⚠️ NEVER commit .env or .env.local to GitHub or public repositories.
# ==============================================================================

# ─── 1. PostgreSQL Database ───────────────────────────────────────────────────
# Connection string for Neon, Supabase, AWS RDS, or local PostgreSQL:
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# ─── 2. Authentication (JWT) ─────────────────────────────────────────────────
# Session signing key. Generate a strong random key (e.g. `openssl rand -hex 32`):
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_here

# ─── 3. Google Maps JavaScript API (Optional) ────────────────────────────────
# Used for Google Maps satellite hybrid views and live traffic layers.
# If omitted, GABRIEL automatically falls back to Leaflet + OpenStreetMap.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ─── 4. Routing & OSRM Engine (Python Backend) ────────────────────────────────
# Base URL of the OSRM routing engine (default: public car routing service)
OSRM_BASE_URL=https://router.project-osrm.org

# ─── 5. Real-Time Socket.IO Server ───────────────────────────────────────────
# Port for the Node.js Socket.IO server bridge (default: 4000)
SOCKET_PORT=4000
SOCKET_SERVER_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# ─── 6. Routing Recalculation Thresholds ─────────────────────────────────────
# Minimum seconds between GPS route recalculations
ROUTE_RECALC_INTERVAL_SECONDS=4.0
# Minimum distance moved (meters) before recalculating route
MIN_DISTANCE_RECALC_METERS=35.0
# Time savings (minutes) required to fire dynamic reroute recommendation
REROUTE_SAVINGS_MINUTES_THRESHOLD=2.0
